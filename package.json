{
  "name": "urban-hive",
  "private": true,
  "description": "Urban Hive website, admin panel and API",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @urban-hive/web",
    "dev:api": "npm run dev -w @urban-hive/api",
    "build": "npm run build -w @urban-hive/web",
    "preview": "npm run preview -w @urban-hive/web",
    "lint": "npm run lint -w @urban-hive/web",
    "db:migrate": "npm run db:migrate -w @urban-hive/api",
    "db:seed": "npm run db:seed -w @urban-hive/api --",
    "create-admin": "npm run create-admin -w @urban-hive/api --"
  },
  "engines": {
    "node": "22.x"
  }
}
