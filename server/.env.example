# Copy this file to `.env` and fill in the values. Never commit `.env`.

# PostgreSQL connection string, e.g. from Neon, Supabase, Render or a local install.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/urban_hive
# Set to true for hosted databases that require SSL (most of them do).
DATABASE_SSL=true

# Long random string used to sign admin login tokens (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long an admin stays signed in.
JWT_EXPIRES_IN=12h

# Website address(es) allowed to call this API, comma separated.
CORS_ORIGIN=http://localhost:5173

PORT=4000

# Max size of a single uploaded photo, in MB.
MAX_UPLOAD_MB=15
